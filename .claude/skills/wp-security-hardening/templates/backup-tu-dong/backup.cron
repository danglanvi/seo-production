# Backup tự động site WordPress. Script: /root/bin/site-backup.sh. Tắt: chuyển file này khỏi /etc/cron.d/.
30 2 * * * root SITE=/www/wwwroot/example.com nice -n 10 ionice -c3 /root/bin/site-backup.sh db >> /var/log/site-backup.log 2>&1
45 2 * * 0 root SITE=/www/wwwroot/example.com nice -n 10 ionice -c3 /root/bin/site-backup.sh files >> /var/log/site-backup.log 2>&1

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- wp-ucss: job tái tạo CSS gọn mỗi ngày 04:10 trên máy local. Thay __LABEL__ (ví dụ com.example.ucss-regen), __SCRIPTS__ (đường dẫn tuyệt đối tới skills/wp-ucss/scripts),
     __SITE_JSON__ (site.json của site), __HOME__ (thư mục home). Đường dẫn có & thì viết &amp;.
     Cài: cp vào ~/Library/LaunchAgents/__LABEL__.plist rồi launchctl bootstrap gui/$(id -u) <file>. Gỡ: launchctl bootout gui/$(id -u)/__LABEL__ -->
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SCRIPTS__/regen.sh</string>
    <string>--site</string>
    <string>__SITE_JSON__</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>10</integer></dict>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/wp-ucss-regen.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/wp-ucss-regen.log</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>5</integer>
</dict>
</plist>
